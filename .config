BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_HOSTNAME="newclier"
BR2_TARGET_GENERIC_ISSUE="NEWCLIER LINUX v2.0"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64_defconfig"
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FRAGMENT=y
BR2_LINUX_KERNEL_BINARY_FORMAT="bzImage"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_KDE_PLASMA_WORKSPACE=y
BR2_PACKAGE_KDE_PLASMA_WAYLAND_SESSION=y
BR2_PACKAGE_WAYDROID=y
BR2_PACKAGE_WAYDROID_SESSION=y
BR2_PACKAGE_FIREFOX=y
BR2_PACKAGE_DOFUSE=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_ISO9660=y
